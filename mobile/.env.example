# Leave blank for automatic Expo-host detection during local development.
# Set an override if your backend runs on a different host.
# Examples:
# - Android Emulator: http://10.0.2.2:8000/api
# - iOS Simulator: http://localhost:8000/api
# - Physical device on local network: http://192.168.1.100:8000/api (replace IP with your server)
# - Production: https://api.example.com/api
EXPO_PUBLIC_API_BASE=
